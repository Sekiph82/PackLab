# PackLab cross-platform local environments and caches.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hiveai/
.cache/
/OwnerDev/

# Local credentials and environment values. Safe example templates remain trackable.
.env
.env.*
!.env.example
!.env.template
*.pem
*.cer
*.p8
*.p12
*.pfx
*.key
*.mobileprovision
*.provisionprofile
*.keychain
*.keychain-db

# Xcode and Swift Package Manager generated state.
DerivedData/
*.xcuserstate
xcuserdata/
.build/
build/
*.xcarchive

# Blender temporary/recovery state and render scratch output.
*.blend1
*.blend2
*.blend@*
blender_tmp/
blender_cache/
renders/_tmp/

# Reconstruction intermediates are regenerable and may contain private evidence.
reconstruction-work/
reconstruction-output/
colmap-work/
openmvs-work/
*.db
*.sqlite
*.sqlite3

# PackLab local/private data; public fixtures must use the tracked assets/tests areas.
local/
private/
data/private/
scans/
*.packscan
*.packlab-cache/
packlab-cache/
packlab-work/
!assets/**/*.packscan
!tests/fixtures/**/*.packscan

# Common operating-system and IDE noise.
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.bak

# Logs and reports that are local by default; coordination evidence remains tracked.
*.log
*.trace
reports/_local/

# PL-0394: raw phone captures, local datasets and secret folders never belong in this public repo.
*.heic
*.HEIC
*.dng
*.DNG
/datasets/
/captures/
/dist/
secrets/
# PL-0394 N5: further key/keystore shapes.
id_rsa*
id_ed25519*
id_ecdsa*
*.der
*.jks
*.keystore
*.ppk
.env.*
