{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://packlab.example/schemas/packscan/1.0/diagnostics.schema.json",
  "title": "PackLab derived diagnostics 1.0",
  "description": "Privacy-bounded diagnostics metadata; never authoritative measurement truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnostic_set_id", "generated_at", "entries"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "diagnostic_set_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_.-]{0,63}$"},
        "severity": {"enum": ["info", "warning", "error"]},
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "allOf": [
            {"not": {"pattern": "(^|[\\\\/])(Users|home|private|tmp|var|AppData|credentials|secrets)([\\\\/]|$)"}},
            {"not": {"pattern": "(^|[ =:_-])([Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Aa][Ss][Ss][Ww][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy])([ =:_-]|$)"}}
          ]
        },
        "count": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "number", "minimum": 0}
      }
    }
  }
}
