root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{py,pyi}]
indent_size = 4

[*.swift]
indent_size = 4

[*.{json,jsonc,yaml,yml,toml}]
indent_size = 2

[*.md]
indent_size = 2

[*.ps1]
indent_size = 4

[*.{pbxproj,xcworkspacedata}]
indent_size = 4
